[Unit]
Description=LED sign phone page
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/led-sign/web/server.py --port 80 --settings /var/lib/led-sign/settings
User=@USER@
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
